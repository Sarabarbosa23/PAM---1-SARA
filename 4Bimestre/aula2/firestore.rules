rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{usuarioId} {
      allow read: if request.auth != null
        && request.auth.uid == usuarioId;

      allow create, update: if request.auth != null
        && request.auth.uid == usuarioId
        && request.resource.data.uid == usuarioId
        && request.resource.data.keys().hasAll([
          'uid',
          'email',
          'nome',
          'idade',
          'personagemFavorito',
          'biografia',
          'atualizadoEm'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'nome',
          'idade',
          'personagemFavorito',
          'biografia',
          'atualizadoEm'
        ])
        && request.resource.data.nome is string
        && request.resource.data.idade is string
        && request.resource.data.personagemFavorito is string
        && request.resource.data.biografia is string;

      allow delete: if request.auth != null
        && request.auth.uid == usuarioId;
    }

    match /personagens/{personagemId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.tipo is string
        && request.resource.data.tipo.size() > 0;

      allow read, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.tipo is string
        && request.resource.data.tipo.size() > 0;
    }
  }
}